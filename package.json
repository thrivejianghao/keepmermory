{
  "name": "ai-photo-skill-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Skill-driven AI photo creation platform local MVP",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.19.0"
  },
  "scripts": {
    "build": "tsc --build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "dev": "pnpm --parallel --filter @ai-photo/api --filter @ai-photo/admin dev",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --build --pretty false",
    "prisma:generate": "pnpm --filter @ai-photo/database prisma:generate",
    "prisma:validate": "pnpm --filter @ai-photo/database prisma:validate",
    "prisma:seed": "pnpm --filter @ai-photo/database prisma:seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  }
}
