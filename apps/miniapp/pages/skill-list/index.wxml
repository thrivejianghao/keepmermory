<view class="page"><view class="filter"><text wx:for="{{categories}}" wx:key="*this" class="{{selected === item ? 'active' : ''}}" data-value="{{item}}" bindtap="chooseCategory">{{item}}</text></view><view wx:if="{{loading}}" class="state">正在加载…</view><view wx:elif="{{error}}" class="state error"><text>{{error}}</text><button class="secondary" bindtap="load">重试</button></view><view wx:elif="{{visible.length}}" class="skill-grid"><skill-card wx:for="{{visible}}" wx:key="id" skill="{{item}}" index="{{index}}" /></view><view wx:else class="state">这个分类还没有玩法</view></view>
