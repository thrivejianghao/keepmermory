.works-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2); margin-top: var(--space-4); }
.work { overflow: hidden; background: var(--surface); border: 2rpx solid var(--line); border-radius: var(--r-sm); }
.work image { display: block; width: 100%; height: 330rpx; background: var(--soft); }
.work-meta { min-height: 72rpx; display: flex; align-items: center; gap: var(--space-1); padding: 8rpx 8rpx 8rpx var(--space-2); }
.work-meta > text { min-width: 0; flex: 1; overflow: hidden; color: var(--muted); font-size: var(--text-xs); text-overflow: ellipsis; white-space: nowrap; }
.more { width: 58rpx; height: 54rpx; min-height: 0; flex: 0 0 58rpx; padding: 0; line-height: 46rpx; border: 0; background: transparent; color: var(--ink); font-size: 38rpx; font-weight: 700; }
.more::after { border: 0; }
.inline-error { display: flex; justify-content: space-between; gap: var(--space-2); margin-top: var(--space-3); color: var(--danger); font-size: var(--text-sm); }
.inline-error text:last-child { color: var(--ink); font-weight: 700; }
.load-more { width: 240rpx; height: 76rpx; margin: var(--space-4) auto 0; line-height: 72rpx; border: 2rpx solid var(--line); background: var(--surface); font-size: var(--text-sm); }
.end-note { display: block; margin-top: var(--space-4); color: var(--muted); font-size: var(--text-xs); text-align: center; }
