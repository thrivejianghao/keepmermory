<view class="page"><text class="eyebrow">YOUR ARCHIVE</text><text class="title">我的作品</text><view wx:if="{{items.length}}" class="works-grid"><view wx:for="{{items}}" wx:key="task.id" class="work" data-id="{{item.task.id}}" bindtap="open"><image src="{{apiBase}}/files/{{item.outputs[0].objectKey}}" mode="aspectFill" /><text>{{item.task.taskNo}}</text></view></view><view wx:elif="{{loading}}" class="state">正在整理作品…</view><view wx:elif="{{error}}" class="state error"><text>{{error}}</text><button class="secondary" bindtap="load">重试</button></view><view wx:else class="state"><strong>还没有作品</strong><text>从一个喜欢的玩法开始</text><button class="primary" bindtap="create">去创作</button></view></view>
