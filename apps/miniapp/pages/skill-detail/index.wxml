<view class="page detail"><view wx:if="{{loading}}" class="state">正在展开玩法…</view><view wx:elif="{{error}}" class="state error"><text>{{error}}</text><button class="secondary" bindtap="load">重试</button></view><block wx:elif="{{skill}}"><view class="hero-art"><text>{{skill.name}}</text></view><text class="eyebrow">{{skill.category}} · {{skill.version}}</text><text class="title">{{skill.name}}</text><text class="description">{{skill.description}}</text><view class="before-after"><view><text>BEFORE</text><view>原始照片</view></view><view><text>AFTER</text><view>完整作品</view></view></view><view class="requirements surface"><strong>照片要求</strong><text>{{skill.input.images.min}}–{{skill.input.images.max}} 张清晰照片</text><text>人物面部与主体尽量完整</text></view><button class="primary fixed-action" bindtap="create">立即制作</button></block></view>
