<view class="page detail">
  <view wx:if="{{loading}}" class="state">正在展开 Skill…</view>
  <view wx:elif="{{error}}" class="state error"><text>{{error}}</text><button class="secondary" bindtap="load">重试</button></view>
  <block wx:elif="{{skill}}">
    <image wx:if="{{skill.coverUrl}}" class="hero-image" src="{{skill.coverUrl}}" mode="aspectFill" />
    <view wx:else class="hero-art"><text>{{skill.name}}</text></view>
    <text class="eyebrow">{{skill.category}} · {{skill.version}}</text>
    <text class="title">{{skill.name}}</text>
    <text class="description">{{skill.description}}</text>
    <view class="before-after">
      <view><text>BEFORE</text><view class="before-tile">原始照片</view></view>
      <view><text>AFTER</text><image wx:if="{{skill.coverUrl}}" src="{{skill.coverUrl}}" mode="aspectFill" /><view wx:else class="after-tile">{{skill.name}}</view></view>
    </view>
    <view class="requirements surface">
      <text class="block-title">照片要求</text>
      <text>{{skill.input.images.min}}–{{skill.input.images.max}} 张清晰照片</text>
      <text>人物面部与主体尽量完整</text>
    </view>
    <view wx:if="{{parameterFields.length}}" class="requirements surface">
      <text class="block-title">可调参数</text>
      <view wx:for="{{parameterFields}}" wx:key="key" class="manifest-row"><text>{{item.label}}</text><text>{{item.type === 'select' ? item.options.length + ' 个选项' : item.type}}</text></view>
    </view>
    <button class="primary fixed-action" bindtap="create">立即制作</button>
  </block>
</view>
