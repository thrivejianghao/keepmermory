.photo-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; margin: 36rpx 0 28rpx; }
.photo, .add-photo { aspect-ratio: 1; border-radius: var(--r-md); overflow: hidden; }
.photo image { width: 100%; height: 100%; }
.add-photo { display: flex; flex-direction: column; align-items: center; justify-content: center; border: 2rpx dashed #bcbcb5; color: var(--muted); }
.add-photo text { color: var(--ink); font-size: 56rpx; }
.parameter { display: flex; align-items: center; justify-content: space-between; padding: 24rpx; margin-bottom: 16rpx; }
.parameter picker { color: var(--muted); }
.error-message { color: var(--danger); padding: 20rpx 0; }
.primary { margin-top: 24rpx; }
