<view class="page"><view wx:if="{{loading}}" class="state">正在准备…</view><block wx:elif="{{skill}}"><text class="eyebrow">{{skill.name}}</text><text class="title">选择一张喜欢的照片</text><view class="photo-grid"><view wx:for="{{photos}}" wx:key="*this" class="photo" data-src="{{item}}" bindtap="preview"><image src="{{item}}" mode="aspectFill" /></view><view wx:if="{{photos.length < skill.input.images.max}}" class="add-photo" bindtap="choose"><text>＋</text><small>选择照片</small></view></view><view wx:for="{{parameterList}}" wx:key="key" class="parameter surface"><text>{{item.label}}</text><picker mode="selector" range="{{item.options}}" range-key="label" data-index="{{index}}" bindchange="changeParameter"><view>{{item.value}}⌄</view></picker></view><view wx:if="{{error}}" class="error-message">{{error}}</view><button class="primary" loading="{{uploading}}" disabled="{{uploading}}" bindtap="generate">{{uploading ? '正在上传…' : '开始生成'}}</button></block></view>
