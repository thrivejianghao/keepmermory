.identity { padding: 54rpx 0 42rpx; display: flex; flex-direction: column; align-items: center; gap: 10rpx; }
.identity > view { width: 116rpx; height: 116rpx; display: grid; place-items: center; border-radius: 50%; background: var(--ink); color: var(--accent); font-size: 46rpx; font-weight: 900; }
.identity > text { font-size: var(--text-lg); font-weight: 700; }
.identity .version, .privacy { color: var(--muted); font-size: var(--text-xs); font-weight: 400; }
.menu { overflow: hidden; }
.menu view { min-height: 92rpx; padding: 0 var(--space-3); display: flex; align-items: center; justify-content: space-between; border-bottom: 2rpx solid var(--line); }
.menu view:last-child { border-bottom: 0; }
.menu view text:last-child { color: var(--muted); font-size: var(--text-lg); }
.privacy { display: block; margin-top: var(--space-3); text-align: center; }
