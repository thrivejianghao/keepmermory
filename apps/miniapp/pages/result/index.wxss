.result { padding-bottom: calc(64rpx + env(safe-area-inset-bottom)); }
.result-skill { display: block; margin-top: 12rpx; font-size: 38rpx; font-weight: 800; }
.result-image { width: 100%; min-height: 600rpx; margin: var(--space-4) 0 var(--space-3); background: var(--soft); border-radius: var(--r-md); }
.actions { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-2); margin-top: var(--space-2); }
.text-action { width: 100%; height: 80rpx; margin-top: var(--space-2); border: 0; background: transparent; color: var(--muted); font-size: var(--text-sm); }
.text-action::after { border: 0; }
