<view class="page result"><view wx:if="{{loading}}" class="state">正在装裱作品…</view><view wx:elif="{{error}}" class="state error"><text>{{error}}</text><button class="secondary" bindtap="load">重试</button></view><block wx:elif="{{result}}"><text class="eyebrow">CREATION COMPLETE</text><text class="title">这一刻，做好了</text><image class="result-image" src="{{result.outputs[0].url}}" mode="widthFix" bindtap="preview" /><button class="primary" bindtap="save">保存图片</button><view class="actions"><button class="secondary" bindtap="again">再次生成</button><button class="secondary" bindtap="change">换个玩法</button></view></block></view>
