<view class="page result">
  <view wx:if="{{loading}}" class="state">正在装裱作品…</view>
  <view wx:elif="{{error && !result}}" class="state error"><text>{{error}}</text><button class="secondary" bindtap="load">重试</button></view>
  <block wx:elif="{{result}}">
    <text class="eyebrow">CREATION COMPLETE</text>
    <text class="result-skill">{{skill ? skill.name : result.task.skillId}}</text>
    <image class="result-image" src="{{result.outputs[0].url}}" mode="widthFix" bindtap="preview" />
    <view wx:if="{{error}}" class="error-message">{{error}}</view>
    <button class="primary" loading="{{saving}}" disabled="{{saving}}" bindtap="save">{{saving ? '正在保存…' : '保存图片'}}</button>
    <view class="actions">
      <button class="secondary" bindtap="again">再次生成</button>
      <button class="secondary" bindtap="previewSource" disabled="{{!sourceUrls.length}}">查看原图</button>
    </view>
    <button class="text-action" bindtap="backToSkill">返回 Skill</button>
  </block>
</view>
