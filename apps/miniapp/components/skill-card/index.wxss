.card { overflow: hidden; background: var(--surface); border: 2rpx solid var(--line); border-radius: var(--r-md); }
image, .art { display: block; width: 100%; height: 330rpx; }
.featured image, .featured .art { height: 560rpx; }
.art { display: grid; place-items: center; padding: var(--space-4); color: var(--surface); font-size: 64rpx; font-weight: 900; text-align: center; }
.art-0 { background: var(--blue); } .art-1 { background: var(--coral); } .art-2 { background: var(--green); } .art-3 { background: var(--violet); }
.copy { padding: 20rpx; display: flex; flex-direction: column; gap: 8rpx; }
.name { font-size: 30rpx; font-weight: 700; }
.description { color: var(--muted); font-size: var(--text-sm); line-height: 1.5; }
