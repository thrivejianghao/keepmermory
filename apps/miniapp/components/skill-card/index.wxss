.card { overflow: hidden; background: #fff; border: 2rpx solid #e5e5e1; border-radius: 12rpx; }
image, .art { display: block; width: 100%; height: 330rpx; }
.art { display: grid; place-items: center; color: #fff; font-size: 84rpx; font-weight: 900; }
.art-0 { background: #345995; } .art-1 { background: #e56b6f; } .art-2 { background: #557c5b; } .art-3 { background: #8d5a97; }
.copy { padding: 20rpx; display: flex; flex-direction: column; gap: 8rpx; }
.name { font-size: 30rpx; font-weight: 700; }
.description { color: #737373; font-size: 23rpx; line-height: 1.5; }
