<view class="card {{featured ? 'featured' : ''}}" bindtap="open"><image wx:if="{{skill.coverUrl}}" src="{{skill.coverUrl}}" mode="aspectFill" /><view wx:else class="art art-{{index % 4}}"><text>{{skill.name}}</text></view><view class="copy"><text class="name">{{skill.name}}</text><text class="description">{{skill.description}}</text></view></view>
